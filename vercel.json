{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run typecheck && pnpm --filter @workspace/100b-website run build",
  "outputDirectory": "artifacts/100b-website/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
