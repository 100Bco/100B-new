# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.vite/
.turbo/
.next/
.cache/

# Generated mockup components (regenerated by mockupPreviewPlugin on dev/build,
# but a seed is committed so monorepo typecheck passes on fresh clones).
# Keep the seed file — only ignore other generated content.
artifacts/*/src/.generated/*
!artifacts/mockup-sandbox/src/.generated/mockup-components.ts

# TypeScript build info
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
